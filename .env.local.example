# Accumu v2 — 프런트엔드(Vite) 클라이언트 전용 환경변수
#
# 이 파일은 템플릿(커밋용)입니다. 실제 값을 채운 뒤 파일명을 .env.local 로 복사해서 사용하세요.
#   cp .env.local.example .env.local
#
# 참고: Vite는 VITE_ 접두사가 붙은 변수만 클라이언트 번들에 노출합니다 (ADR 0001 6장).
#  - 여기에는 anon key만 둡니다. service_role 키는 절대 이 파일에 넣지 마세요 (.env.seed 전용).
#
# 값은 Supabase 대시보드 > Project Settings > API 에서 확인할 수 있습니다.

VITE_SUPABASE_URL=X
VITE_SUPABASE_ANON_KEY=X

# 네이버 로그인 (ADR 0009). 없으면 네이버 버튼이 비활성으로 표시되고 나머지 기능은 그대로 동작합니다.
#  - 값은 네이버 개발자센터(developers.naver.com/apps) > 애플리케이션 > 클라이언트 ID
#  - Client "Secret" 은 여기에 넣지 마세요. 프런트 번들에 노출됩니다.
#    시크릿은 Edge Function 환경변수로만 둡니다:
#      supabase secrets set NAVER_CLIENT_ID=... NAVER_CLIENT_SECRET=...
VITE_NAVER_CLIENT_ID=X

# 구글 로그인 (ADR 0011). 네이버와 완전히 같은 방식이다 — Supabase Providers 설정이 아니다.
#  - 값은 Google Cloud Console > 사용자 인증 정보 > OAuth 클라이언트 ID(웹)
#  - 승인된 리디렉션 URI 는 **앱 주소**다: http://localhost:5173/auth/google
#    (Supabase 콜백 주소가 아니다. 이걸 반대로 넣는 것이 가장 흔한 실수다.)
#  - Client "Secret" 은 여기 넣지 마세요. Edge Function 환경변수로만 갑니다:
#      supabase secrets set GOOGLE_CLIENT_ID=... GOOGLE_CLIENT_SECRET=...
VITE_GOOGLE_CLIENT_ID=X
