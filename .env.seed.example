# Accumu v2 — 시딩 전용 환경변수 (scripts/seed-accounts.mjs, scripts/seed-programs.mjs가 읽음)
#
# 이 파일은 템플릿(커밋용)입니다. 실제 값을 채운 뒤 파일명을 .env.seed 로 복사해서 사용하세요.
#   cp .env.seed.example .env.seed
#
# 중요: SUPABASE_SERVICE_ROLE_KEY는 RLS를 완전히 우회하는 매우 민감한 키입니다.
#  - 절대 VITE_ 접두사를 붙이지 마세요 (붙이면 프런트 번들에 노출됩니다, ADR 0001 6장 참고)
#  - 절대 git에 커밋하지 마세요 (.env.seed는 .gitignore에 등록되어 있어야 합니다)
#  - Node 시딩 스크립트(scripts/seed-*.mjs) 외 다른 코드에서 import하지 마세요
#
# 시딩 실행 순서: 마이그레이션 적용 -> node seed-accounts.mjs -> node seed-programs.mjs
#
# 값은 Supabase 대시보드 > Project Settings > API 에서 확인할 수 있습니다.

SUPABASE_URL=X
SUPABASE_SERVICE_ROLE_KEY=X

# RLS 회귀 테스트(scripts/test-rls.mjs)가 추가로 읽는 값.
#  - 검증 요청은 전부 anon 키로 나간다. service_role 로 테스트하면 RLS 를 우회해
#    모든 테스트가 통과하고 아무것도 검증하지 않는다.
#  - .env.local 에 VITE_SUPABASE_ANON_KEY 가 있으면 그 값을 쓰므로 보통은 비워둬도 된다.
SUPABASE_ANON_KEY=
